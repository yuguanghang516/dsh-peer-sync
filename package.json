{
  "name": "dsh-peer-sync",
  "version": "0.9.2",
  "description": "DSH LAN sync plugin: keep Windows DeepSeek Harness and Android DSH Go sessions, shared files and plugins in step over Wi-Fi.",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "lan.js",
    "extras.js",
    "discovery.js",
    "cordis.patch.yml",
    "README.txt",
    "pair.py",
    "update.js",
    "README.md",
    "README.en.md",
    "attachments.js",
    "LICENSE",
    "center.js",
    "policy.js",
    "organizer.js",
    "pairing.js",
    "desktop-panel.js",
    "panel.html",
    "manual.js",
    "trash.js"
  ],
  "keywords": [
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "dsh-go",
    "lan-sync",
    "peer-sync",
    "session-sync"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  },
  "dshGo": {
    "v": 1,
    "title": {
      "zh": "局域双端同步",
      "en": "LAN peer sync"
    },
    "icon": "refresh",
    "contributes": {
      "composer.strip": [
        {
          "id": "peer-sync-status",
          "icon": "refresh",
          "panel": "peer-home"
        }
      ],
      "panels": [
        {
          "id": "peer-home",
          "title": {
            "zh": "同步中心",
            "en": "Sync center"
          },
          "icon": "refresh",
          "placement": [
            "features",
            "chat.panel"
          ]
        },
        {
          "id": "peer-pair",
          "title": {
            "zh": "配对设备",
            "en": "Pair devices"
          },
          "icon": "team",
          "placement": [
            "features"
          ]
        },
        {
          "id": "peer-chats",
          "title": {
            "zh": "选择聊天",
            "en": "Choose chats"
          },
          "icon": "chats",
          "placement": [
            "features"
          ]
        },
        {
          "id": "peer-settings",
          "title": {
            "zh": "设备设置",
            "en": "Device settings"
          },
          "icon": "refresh",
          "placement": []
        },
        {
          "id": "peer-roles",
          "title": {
            "zh": "传输方向",
            "en": "Direction"
          },
          "icon": "refresh",
          "placement": []
        },
        {
          "id": "peer-delete",
          "title": {
            "zh": "删除聊天",
            "en": "Delete a chat"
          },
          "icon": "refresh",
          "placement": []
        }
      ]
    }
  },
  "author": "yuguanghang516",
  "repository": "https://github.com/yuguanghang516/dsh-peer-sync.git",
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  }
}
